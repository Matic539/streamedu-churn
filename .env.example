# Copia este archivo como .env y reemplaza los valores. El .env nunca se sube al repositorio.
# Cadena de Atlas: Connect > Drivers > Python. Usa el usuario streamedu_app (readWrite solo en streamedu_db).
MONGO_URI="mongodb+srv://streamedu_app:<db_password>@<cluster>.mongodb.net/?retryWrites=true&w=majority"
DB_NAME="streamedu_db"
